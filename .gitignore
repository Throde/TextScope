# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environment (recreate with python3.11 -m venv)
/textscope/
/.venv/
/venv/
/env/

# PyInstaller / packaging outputs (published via GitHub Releases instead)
/build/
/dist/
*.dmg
*.pkg

# macOS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Generated frequency caches (regenerated at runtime)
/data/*.pkl

# Logs
*.log
